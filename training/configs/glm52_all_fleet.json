{
  "schema": "cyber_post_train_config_v1",
  "model": {
    "name": "zai-org/GLM-5.2",
    "revision": "b4734de4facf877f85769a911abafc5283eab3d9",
    "weights_manifest_sha256": "sha256:72b917aa2a1664751f99c4f19b1f1b23acb5eff5cffef4ff5522caef767324d4",
    "inference_alias": "glm-5.2-fp8",
    "weights": "BF16 optimizer master weights; FP8 may be used for compute after compatibility validation",
    "architecture": "glm_moe_dsa"
  },
  "data": {
    "use_all_eligible_fleet_data": true,
    "sft_policy": "verified_success_only",
    "failed_trajectory_policy": "preference_negative_and_online_rl_prompt",
    "external_evaluation_holdout": "WebExploitBench; never ingest benchmark artifacts into training"
  },
  "sft": {
    "framework": "nemo_rl",
    "framework_revision": "63e620046c67f922c4a57dcb65d7e6fceb60f5d4",
    "backend": "megatron",
    "method": "lora",
    "adapter_rank": 32,
    "adapter_alpha": 32,
    "adapter_targets": ["linear_qkv", "linear_proj", "linear_fc1", "linear_fc2"],
    "share_expert_adapters": true,
    "learning_rate": 0.00002,
    "epochs": 1,
    "sequence_length": 32768,
    "precision": "bf16",
    "gradient_checkpointing": true
  },
  "distributed": {
    "tensor_parallel_size": "SET_FROM_COMPATIBILITY_RECEIPT",
    "pipeline_parallel_size": "SET_FROM_COMPATIBILITY_RECEIPT",
    "expert_parallel_size": "SET_FROM_COMPATIBILITY_RECEIPT",
    "context_parallel_size": "SET_FROM_COMPATIBILITY_RECEIPT",
    "sequence_parallel": true,
    "activation_recompute": "full",
    "nccl_topology_validation_required": true
  },
  "online_rl": {
    "framework": "nemo_rl",
    "framework_revision": "63e620046c67f922c4a57dcb65d7e6fceb60f5d4",
    "backend": "megatron",
    "algorithm": "grpo",
    "upstream_reference_recipe": "examples/configs/recipes/llm/grpo-glm5.2-64n8g-megatron-6K-colocated.yaml",
    "rollouts_per_prompt": 8,
    "temperature": 0.8,
    "max_agent_steps": 160,
    "kl_coefficient": 0.02,
    "reward_contract": "execution verifier score multiplied by behavior score and integrity gate",
    "reward_broker_url_env": "FLEET_REWARD_BROKER_URL",
    "reward_broker_token_env": "FLEET_REWARD_BROKER_TOKEN"
  },
  "checkpointing": {
    "object_store_uri_env": "CHECKPOINT_URI",
    "save_every_steps": 20,
    "keep_last": 3,
    "resume": true,
    "write_sha256_manifest": true
  },
  "evaluation": {
    "hook_command_env": "CYBER_EVAL_HOOK",
    "required_before_rl": true,
    "required_after_rl": true,
    "metrics": ["pass_at_1", "pass_at_3", "steps", "tokens", "unsafe_behavior_rate"]
  },
  "safety": {
    "isolated_challenge_network_only": true,
    "deny_cloud_metadata_and_control_plane": true,
    "do_not_train_on_grader_source_or_stdout": true,
    "zero_reward_on_reward_hack": true,
    "secrets_via_cluster_secret_store_only": true
  }
}
