FROM docker.io/library/node@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96

ARG QWEN_CODE_VERSION=0.22.3
ARG QWEN_CODE_TARBALL_SHA1=1529461d6c79c273b184849e6777e54ac98ae860
ARG QWEN_CODE_TARBALL_SHA512=f0d832fd9127fa274ec8dde4e762bd4cdbbf5d290d7d2da1cb3b2291e4837bbf6445ddbf78c61b58b399aba2c74865585d536963a92da5f64bb61c58e401d678

RUN npm pack "@qwen-code/qwen-code@${QWEN_CODE_VERSION}" --pack-destination /tmp \
    && echo "${QWEN_CODE_TARBALL_SHA1}  /tmp/qwen-code-qwen-code-${QWEN_CODE_VERSION}.tgz" \
      | sha1sum --check --strict \
    && echo "${QWEN_CODE_TARBALL_SHA512}  /tmp/qwen-code-qwen-code-${QWEN_CODE_VERSION}.tgz" \
      | sha512sum --check --strict \
    && npm install --global --prefix /usr "/tmp/qwen-code-qwen-code-${QWEN_CODE_VERSION}.tgz" \
    && test "$(qwen --version)" = "${QWEN_CODE_VERSION}"

USER node
WORKDIR /home/node/workspace
ENV HOME=/home/node
