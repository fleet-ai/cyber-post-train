{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qwen38-miles-signal-live-task-receipt-v1.schema.json",
  "title": "Sanitized exact Fleet task-state receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observed_at",
    "authority_config_sha256",
    "authority_source_commit",
    "account",
    "task_set_sha256",
    "production_split_sha256",
    "tool_catalog_sha256",
    "candidates",
    "privacy",
    "sha256"
  ],
  "properties": {
    "schema": {"const": "cyber_qwen38_miles_signal_live_task_receipt_v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "authority_config_sha256": {"$ref": "#/$defs/sha256"},
    "authority_source_commit": {"$ref": "#/$defs/commit"},
    "account": {
      "const": {
        "team_id": "a1025f0b-ad67-49fc-a023-51800ab43e84",
        "team_name": "fleet"
      }
    },
    "task_set_sha256": {"$ref": "#/$defs/sha256"},
    "production_split_sha256": {"$ref": "#/$defs/sha256"},
    "tool_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "task",
          "environment",
          "verifier",
          "split",
          "authority_receipt_sha256",
          "live_binding_receipt_sha256",
          "binding_sha256"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "task": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "version_id",
              "prompt_sha256",
              "env_variables_sha256",
              "output_json_schema_sha256",
              "cyber_contract_sha256",
              "lifecycle_status"
            ],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "version_id": {"type": "string", "format": "uuid"},
              "prompt_sha256": {"$ref": "#/$defs/sha256"},
              "env_variables_sha256": {"$ref": "#/$defs/sha256"},
              "output_json_schema_sha256": {"$ref": "#/$defs/sha256"},
              "cyber_contract_sha256": {"$ref": "#/$defs/sha256"},
              "lifecycle_status": {"const": "production"}
            }
          },
          "environment": {"$ref": "#/$defs/environment"},
          "verifier": {"$ref": "#/$defs/verifier"},
          "split": {"const": "train"},
          "authority_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "live_binding_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "binding_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "privacy": {
      "const": {
        "prompt_text_included": false,
        "verifier_code_included": false,
        "env_values_included": false,
        "credentials_included": false
      }
    },
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "version_id",
        "data_id",
        "data_version",
        "runtime_seed_content_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "format": "uuid"},
        "data_id": {"type": "string", "minLength": 1},
        "data_version": {"type": "string", "minLength": 1},
        "runtime_seed_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version_id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
